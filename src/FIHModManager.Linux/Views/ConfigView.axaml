<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:FIHModManager.Infrastructure"
             xmlns:vm="using:FIHModManager.ViewModels"
             x:Class="FIHModManager.Views.ConfigView">
    <UserControl.Styles>
        <Style Selector="Border.entry.modified">
            <Setter Property="BorderBrush" Value="#66E0344B" />
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="32,4,32,24">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <Button Classes="icon" Content="{x:Static loc:Icons.Folder}" ToolTip.Tip="{loc:Tr config.openFolder.tip}" Command="{Binding OpenConfigFolderCommand}" />
                <Button Content="{loc:Tr config.discard}" Command="{Binding ReloadConfigCommand}" />
                <Button Classes="primary" Command="{Binding SaveConfigCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="icon" Text="{x:Static loc:Icons.Save}" FontSize="16" />
                        <TextBlock Text="{loc:Tr config.save}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{loc:Tr nav.config}" Classes="h1" />
                <TextBlock Text="{loc:Tr config.subtitle}" Classes="muted" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <Border DockPanel.Dock="Top" Classes="card" Padding="32" IsVisible="{Binding ConfigFiles.Count, Converter={StaticResource NoItems}}">
            <StackPanel HorizontalAlignment="Center" Spacing="6">
                <TextBlock Classes="icon" Text="{x:Static loc:Icons.Config}" FontSize="44" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Text="{loc:Tr config.empty.title}" Classes="h2" HorizontalAlignment="Center" Margin="0,8,0,0" />
                <TextBlock Text="{loc:Tr config.empty.text}" Classes="muted" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <Grid ColumnDefinitions="250,16,*" IsVisible="{Binding ConfigFiles.Count, Converter={StaticResource HasItems}}">
            <Border Classes="card" Padding="8">
                <ListBox Classes="select" ItemsSource="{Binding ConfigFiles}" SelectedItem="{Binding SelectedConfig}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:ConfigFileViewModel">
                            <DockPanel>
                                <Panel DockPanel.Dock="Left" Margin="0,0,10,0">
                                    <TextBlock Classes="icon" Text="{x:Static loc:Icons.CfgFile}" FontSize="16" Foreground="{StaticResource MutedBrush}" IsVisible="{Binding IsCfg}" />
                                    <TextBlock Classes="icon" Text="{x:Static loc:Icons.TextFile}" FontSize="16" Foreground="{StaticResource MutedBrush}" IsVisible="{Binding !IsCfg}" />
                                </Panel>
                                <Ellipse DockPanel.Dock="Right" Width="7" Height="7" Fill="{StaticResource AccentBrush}" IsVisible="{Binding IsDirty}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="2" Classes="card" Padding="0" DataContext="{Binding SelectedConfig}">
                <Panel>
                    <!-- .cfg estructurado -->
                    <ScrollViewer IsVisible="{Binding IsCfg}">
                        <ItemsControl ItemsSource="{Binding Sections}" Margin="18,14,18,18">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:ConfigSectionViewModel">
                                    <StackPanel Margin="0,4,0,10">
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="4,6,0,8" />
                                        <ItemsControl ItemsSource="{Binding Entries}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:ConfigEntryViewModel">
                                                    <Border Classes="entry" Padding="16,12" Margin="0,0,0,6" CornerRadius="10" Background="{StaticResource Surface2Brush}"
                                                            BorderThickness="1" BorderBrush="Transparent" Classes.modified="{Binding IsModified}">
                                                        <DockPanel>
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                                                <ToggleSwitch Classes="switch" IsChecked="{Binding BoolValue}"
                                                                              IsVisible="{Binding Kind, Converter={StaticResource Equals}, ConverterParameter=Toggle}" />
                                                                <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Value}" Width="220"
                                                                          IsVisible="{Binding Kind, Converter={StaticResource Equals}, ConverterParameter=Choice}" />
                                                                <TextBox Text="{Binding Value}" Width="220"
                                                                         IsVisible="{Binding Kind, Converter={StaticResource Equals}, ConverterParameter=Text}" />
                                                                <ItemsControl ItemsSource="{Binding Flags}" MaxWidth="320"
                                                                              IsVisible="{Binding Kind, Converter={StaticResource Equals}, ConverterParameter=Flags}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel HorizontalAlignment="Right" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate DataType="vm:ConfigFlagViewModel">
                                                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="8,0,0,0" FontSize="12" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <Button Classes="icon" Content="{x:Static loc:Icons.Reset}" Width="30" Height="30" FontSize="16"
                                                                        ToolTip.Tip="{loc:Tr config.reset.tip}" Command="{Binding ResetCommand}" />
                                                            </StackPanel>
                                                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <TextBlock Text="{Binding Key}" FontWeight="SemiBold" FontSize="14" />
                                                                    <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"
                                                                             ToolTip.Tip="{loc:Tr config.modified.tip}" IsVisible="{Binding IsModified}" />
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Description}" Classes="muted" FontSize="12" Margin="0,3,0,0"
                                                                           IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                                <TextBlock Text="{Binding Hint}" FontSize="11" Foreground="#6E6E88" Margin="0,4,0,0" TextWrapping="Wrap"
                                                                           IsVisible="{Binding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Otros archivos como texto -->
                    <DockPanel Margin="18" IsVisible="{Binding !IsCfg}">
                        <TextBlock DockPanel.Dock="Top" Text="{loc:Tr config.rawNote}" Classes="muted" FontSize="12" Margin="0,0,0,10" />
                        <TextBox Text="{Binding RawText}" AcceptsReturn="True" AcceptsTab="True" FontFamily="monospace" FontSize="12"
                                 VerticalContentAlignment="Top" TextWrapping="NoWrap" />
                    </DockPanel>
                </Panel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
