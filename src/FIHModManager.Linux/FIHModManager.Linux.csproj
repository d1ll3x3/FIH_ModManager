<Project Sdk="Microsoft.NET.Sdk">

  <!-- Interfaz de Linux (Avalonia). La lógica vive en FIHModManager.Core, compartida con la app WPF de Windows. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>FIHModManager</AssemblyName>
    <RootNamespace>FIHModManager</RootNamespace>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FIHModManager.Core\FIHModManager.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Material Icons (Apache 2.0): la fuente de iconos de Windows no existe en Linux -->
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
