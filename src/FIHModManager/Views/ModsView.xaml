<UserControl x:Class="FIHModManager.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FIHModManager.Infrastructure"
             xmlns:vm="clr-namespace:FIHModManager.ViewModels;assembly=FIHModManager.Core"
             Style="{StaticResource PageStyle}">
    <DockPanel Margin="32,4,32,0">
        <!-- Cabecera -->
        <DockPanel DockPanel.Dock="Top">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Content="&#xE8B7;" ToolTip="{loc:Tr mods.openPlugins.tip}" Command="{Binding OpenPluginsFolderCommand}" />
                <Button Content="{loc:Tr mods.checkUpdates}" Command="{Binding CheckUpdatesCommand}" Margin="8,0,0,0" />
                <Button Content="{loc:Tr mods.fromGitHub}" Command="{Binding NavigateCommand}" CommandParameter="Explore" Margin="8,0,0,0" />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddModFileCommand}" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:Tr mods.add}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{loc:Tr nav.mods}" Style="{StaticResource H1}" />
                <TextBlock Text="{Binding ModsInstalledText}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid DockPanel.Dock="Top" Margin="0,20,0,12">
            <TextBox Text="{Binding ModFilter, UpdateSourceTrigger=PropertyChanged}" Tag="{loc:Tr mods.search}" Padding="36,9,10,9" />
            <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Left" Margin="13,0,0,0" />
        </Grid>

        <!-- Filtros por estado -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
            <RadioButton Style="{StaticResource FilterChip}" GroupName="ModStatus"
                         IsChecked="{Binding ModStatus, Converter={StaticResource Equals}, ConverterParameter=All}">
                <TextBlock><Run Text="{loc:Tr mods.filter.all}" /><Run Text="  " /><Run Text="{Binding Mods.Count, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" /></TextBlock>
            </RadioButton>
            <RadioButton Style="{StaticResource FilterChip}" GroupName="ModStatus"
                         IsChecked="{Binding ModStatus, Converter={StaticResource Equals}, ConverterParameter=Enabled}">
                <TextBlock><Run Text="{loc:Tr mods.filter.enabled}" /><Run Text="  " /><Run Text="{Binding EnabledModCount, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" /></TextBlock>
            </RadioButton>
            <RadioButton Style="{StaticResource FilterChip}" GroupName="ModStatus"
                         IsChecked="{Binding ModStatus, Converter={StaticResource Equals}, ConverterParameter=Disabled}">
                <TextBlock><Run Text="{loc:Tr mods.filter.disabled}" /><Run Text="  " /><Run Text="{Binding DisabledModCount, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" /></TextBlock>
            </RadioButton>
            <RadioButton Style="{StaticResource FilterChip}" GroupName="ModStatus"
                         IsChecked="{Binding ModStatus, Converter={StaticResource Equals}, ConverterParameter=Updates}">
                <TextBlock><Run Text="{loc:Tr mods.filter.updates}" /><Run Text="  " /><Run Text="{Binding UpdateCount, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" /></TextBlock>
            </RadioButton>
        </StackPanel>

        <Grid>
            <TextBlock Text="{loc:Tr mods.noMatches}" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,24,0,0"
                       Visibility="{Binding NoModMatches, Converter={StaticResource BoolToVis}}" />
            <!-- Vacío -->
            <Border Style="{StaticResource Card}" VerticalAlignment="Top" Padding="36" BorderBrush="#3D3D52"
                    Visibility="{Binding Mods.Count, Converter={StaticResource InvBoolToVis}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="40" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Text="{loc:Tr mods.empty.title}" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,14,0,6" />
                    <TextBlock Text="{loc:Tr mods.empty.text}" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FilteredMods}" Margin="0,0,0,24">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ModItemViewModel}">
                            <Border x:Name="Card" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,10">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Left" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"
                                              ToolTip="{loc:Tr mods.toggle.tip}" />

                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource PrimaryButton}" Padding="12,6" Margin="0,0,6,0"
                                                Command="{Binding DataContext.UpdateModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding UpdateText}" />
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="{loc:Tr mods.config.tip}"
                                                Command="{Binding DataContext.OpenModConfigCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                Visibility="{Binding HasConfig, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE8B7;" ToolTip="{loc:Tr mods.folder.tip}"
                                                Command="{Binding DataContext.OpenModFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="{loc:Tr mods.delete.tip}"
                                                Command="{Binding DataContext.DeleteModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>

                                    <StackPanel Margin="18,0,12,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Margin="0,0,10,0" />
                                            <Border Style="{StaticResource Badge}" Visibility="{Binding Version, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding Version}" />
                                            </Border>
                                            <Border Style="{StaticResource Badge}" Background="{StaticResource Accent2SoftBrush}" Visibility="{Binding IsGitHub, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" FontSize="10" Margin="0,0,4,0" Foreground="{StaticResource Accent2Brush}" />
                                                    <TextBlock Text="GitHub" Foreground="{StaticResource Accent2Brush}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Badge}" Visibility="{Binding ExtraPlugins, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding ExtraPlugins}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                            <Run Text="{Binding Guid, Mode=OneWay}" /><Run Text="   ·   " /><Run Text="{Binding Entry.SizeBytes, Mode=OneWay, Converter={StaticResource Bytes}}" /><Run Text="   ·   " /><Run Text="{Binding Entry.Key, Mode=OneWay}" />
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding Warning, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="12" Foreground="{StaticResource WarningBrush}" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Warning}" FontSize="12" Foreground="{StaticResource WarningBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                    <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    <Setter TargetName="Card" Property="Background" Value="#14141C" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="#66E0344B" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
