<UserControl x:Class="FIHModManager.Views.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FIHModManager.Infrastructure"
             xmlns:vm="clr-namespace:FIHModManager.ViewModels"
             Style="{StaticResource PageStyle}">
    <UserControl.Resources>
        <!-- Editores según el tipo de opción -->
        <DataTemplate x:Key="ToggleEditor">
            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding BoolValue}" HorizontalAlignment="Right" />
        </DataTemplate>
        <DataTemplate x:Key="ChoiceEditor">
            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Value}" Width="220" />
        </DataTemplate>
        <DataTemplate x:Key="TextEditor">
            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="220" />
        </DataTemplate>
        <DataTemplate x:Key="FlagsEditor">
            <ItemsControl ItemsSource="{Binding Flags}" MaxWidth="320">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Right" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ConfigFlagViewModel}">
                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="10,3,0,3" FontSize="12" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate x:Key="EntryTemplate" DataType="{x:Type vm:ConfigEntryViewModel}">
            <Border x:Name="Row" Padding="16,12" Margin="0,0,0,6" CornerRadius="10" Background="{StaticResource Surface2Brush}"
                    BorderThickness="1" BorderBrush="Transparent">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ContentControl Content="{Binding}" Focusable="False" VerticalAlignment="Center">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Setter Property="ContentTemplate" Value="{StaticResource TextEditor}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:ConfigEditorKind.Toggle}">
                                            <Setter Property="ContentTemplate" Value="{StaticResource ToggleEditor}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:ConfigEditorKind.Choice}">
                                            <Setter Property="ContentTemplate" Value="{StaticResource ChoiceEditor}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:ConfigEditorKind.Flags}">
                                            <Setter Property="ContentTemplate" Value="{StaticResource FlagsEditor}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                        <Button Style="{StaticResource IconButton}" Content="&#xE7A7;" Width="30" Height="30" FontSize="13" Margin="6,0,0,0"
                                ToolTip="{loc:Tr config.reset.tip}" Command="{Binding ResetCommand}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Key}" FontWeight="SemiBold" FontSize="14" />
                            <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="8,0,0,0" ToolTip="{loc:Tr config.modified.tip}"
                                     Visibility="{Binding IsModified, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"
                                   Visibility="{Binding Description, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding Hint}" FontSize="11" Foreground="#6E6E88" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding Hint, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsModified}" Value="True">
                    <Setter TargetName="Row" Property="BorderBrush" Value="#66E0344B" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="32,4,32,24">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Content="&#xE8B7;" ToolTip="{loc:Tr config.openFolder.tip}" Command="{Binding OpenConfigFolderCommand}" />
                <Button Content="{loc:Tr config.discard}" Command="{Binding ReloadConfigCommand}" Margin="8,0,0,0" />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveConfigCommand}" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="{loc:Tr config.save}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{loc:Tr nav.config}" Style="{StaticResource H1}" />
                <TextBlock Text="{loc:Tr config.subtitle}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- Sin configs -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="32"
                Visibility="{Binding ConfigFiles.Count, Converter={StaticResource InvBoolToVis}}">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="40" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Text="{loc:Tr config.empty.title}" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,14,0,6" />
                <TextBlock Text="{loc:Tr config.empty.text}" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <Grid Visibility="{Binding ConfigFiles.Count, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Lista de archivos -->
            <Border Style="{StaticResource Card}" Padding="8">
                <ListBox Style="{StaticResource SelectList}" ItemsSource="{Binding ConfigFiles}" SelectedItem="{Binding SelectedConfig}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ConfigFileViewModel}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0" />
                                <Ellipse DockPanel.Dock="Right" Width="7" Height="7" Fill="{StaticResource AccentBrush}"
                                         Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Editor -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" DataContext="{Binding SelectedConfig}">
                <Grid>
                    <!-- .cfg estructurado -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsCfg, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Sections}" Margin="18,14,18,18">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ConfigSectionViewModel}">
                                    <StackPanel Margin="0,4,0,10">
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="4,6,0,8" />
                                        <ItemsControl ItemsSource="{Binding Entries}" ItemTemplate="{StaticResource EntryTemplate}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Otros (json, txt…) en texto plano -->
                    <DockPanel Margin="18" Visibility="{Binding IsCfg, Converter={StaticResource InvBoolToVis}}">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,10"
                                   Text="{loc:Tr config.rawNote}" />
                        <TextBox Text="{Binding RawText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="12" VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
