<Window x:Class="FIHModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FIHModManager.Infrastructure"
        xmlns:vm="clr-namespace:FIHModManager.ViewModels"
        xmlns:models="clr-namespace:FIHModManager.Models"
        Title="FIH Mod Manager" Width="1220" Height="780" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" Icon="Resources/icon.ico"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" AllowDrop="True"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Barra lateral ================= -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,14,16,16">
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,22">
                    <Border Width="42" Height="42" CornerRadius="11" ClipToBounds="True">
                        <Border.Background>
                            <ImageBrush ImageSource="Resources/icon.png" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="FIH Mod Manager" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="Flipping is Hard" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Selector de instalación -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                    <TextBlock Text="{loc:Tr side.installation}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="4,0,0,6" />
                    <ComboBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" MinHeight="54">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:GameInstall}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource LtrText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource TrKey}" ConverterParameter="origin.">
                                                <Binding Path="Origin" />
                                                <Binding Source="{x:Static loc:Loc.Instance}" Path="Language" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Estado inferior -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="14,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BepInExNeedsInstall}" Value="False">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding BepInExStatusText}" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{Binding ModsActiveText}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="16,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="16,4,0,0" Visibility="{Binding IsGameRunning, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" FontSize="12" Foreground="{StaticResource SuccessBrush}" />
                            <TextBlock Text="{loc:Tr side.gameRunning}" Margin="6,0,0,0" FontSize="12" Foreground="{StaticResource SuccessBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Navegación -->
                <StackPanel>
                    <RadioButton Style="{StaticResource NavButton}" Content="{loc:Tr nav.home}" Tag="&#xE80F;"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=Home}" />
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE8F1;"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=Mods}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Tr nav.mods}" />
                            <Border Background="{StaticResource AccentBrush}" CornerRadius="8" Padding="6,0" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding UpdateCount, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding UpdateCount}" FontSize="11" FontWeight="Bold" Foreground="White" />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" Content="{loc:Tr nav.explore}" Tag="&#xE774;"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=Explore}" />
                    <RadioButton Style="{StaticResource NavButton}" Content="{loc:Tr nav.config}" Tag="&#xE713;"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=Config}" />
                    <RadioButton Style="{StaticResource NavButton}" Content="{loc:Tr nav.profiles}" Tag="&#xE77B;"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=Profiles}" />
                    <RadioButton Style="{StaticResource NavButton}" Content="{loc:Tr nav.settings}" Tag="&#xE90F;"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource Equals}, ConverterParameter=Settings}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= Contenido ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Barra de título -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" />
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" />
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" />
            </StackPanel>

            <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False" />

            <!-- Barra de progreso de operaciones -->
            <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="32,0,0,24" Padding="16,12"
                    Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12"
                    Width="360" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding BusyText}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= Toasts ================= -->
        <ItemsControl Grid.Column="0" Grid.ColumnSpan="2" ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,24,24" Width="380">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ToastViewModel}">
                    <Border x:Name="Toast" Margin="0,8,0,0" Padding="14,12" CornerRadius="12" BorderThickness="1"
                            Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="Black" />
                        </Border.Effect>
                        <Border.RenderTransform>
                            <TranslateTransform X="0" />
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X" From="60" To="0" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <DockPanel>
                            <TextBlock x:Name="Glyph" DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{Binding Glyph}" Margin="0,1,12,0"
                                       VerticalAlignment="Top" Foreground="{StaticResource Accent2Brush}" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="22" Height="22" FontSize="9" Content="&#xE711;"
                                    VerticalAlignment="Top" Margin="8,0,0,0"
                                    Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="13" />
                        </DockPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:ToastKind.Success}">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:ToastKind.Error}">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource DangerBrush}" />
                            <Setter TargetName="Toast" Property="BorderBrush" Value="#66FF5C6C" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ================= Overlay de arrastrar y soltar ================= -->
        <Border x:Name="DropOverlay" Grid.ColumnSpan="2" Background="#D90E0E14" Visibility="Collapsed" IsHitTestVisible="False">
            <Border Margin="40" CornerRadius="24" BorderThickness="2" BorderBrush="{StaticResource AccentBrush}" Background="#14E0344B">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="56" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="{loc:Tr drop.title}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,16,0,6" />
                    <TextBlock Text="{loc:Tr drop.subtitle}" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>

        <!-- ================= Diálogo modal ================= -->
        <Grid Grid.ColumnSpan="2" Background="#B3000000" Visibility="{Binding Dialog, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="26"
                    DataContext="{Binding Dialog}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.5" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" FontSize="18" TextWrapping="Wrap" />
                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"
                                  Visibility="{Binding Message, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Message}" Style="{StaticResource Muted}" />
                    </ScrollViewer>
                    <TextBox x:Name="DialogInput" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding InputPlaceholder}" Margin="0,16,0,0"
                             Visibility="{Binding ShowInput, Converter={StaticResource BoolToVis}}" />
                    <ListBox Style="{StaticResource SelectList}" ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" Margin="0,14,0,0"
                             MaxHeight="240" Visibility="{Binding Choices, Converter={StaticResource BoolToVis}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:GitHubAsset}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Size, Converter={StaticResource Bytes}}" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource LtrText}" FontWeight="SemiBold" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button Content="{Binding SecondaryText}" Command="{Binding SecondaryCommand}" IsCancel="True" Margin="0,0,10,0"
                                Visibility="{Binding SecondaryText, Converter={StaticResource BoolToVis}}" />
                        <Button Content="{Binding PrimaryText}" Command="{Binding PrimaryCommand}" IsDefault="True">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
